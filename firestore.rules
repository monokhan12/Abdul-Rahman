rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email == "quanticschool@gmail.com";
    }

    // Post schema validation
    function isValidPost(post) {
      return post.title is string && post.title.size() > 0 && post.title.size() <= 200 &&
             post.slug is string && post.slug.size() > 0 && post.slug.size() <= 100 &&
             post.date is string && post.date.size() > 0 && post.date.size() <= 50 &&
             post.summary is string && post.summary.size() > 0 && post.summary.size() <= 2000 &&
             post.content is string && post.content.size() > 0 && post.content.size() <= 100000 &&
             post.category is string && post.category.size() > 0 && post.category.size() <= 100 &&
             post.author is string && post.author.size() > 0 && post.author.size() <= 100 &&
             post.createdAt is timestamp;
    }

    // Comment schema validation
    function isValidComment(comment) {
      return comment.postId is string && comment.postId.size() > 0 && comment.postId.size() <= 128 &&
             comment.authorName is string && comment.authorName.size() > 0 && comment.authorName.size() <= 100 &&
             comment.content is string && comment.content.size() > 0 && comment.content.size() <= 4000 &&
             comment.createdAt is timestamp;
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAdmin() && isValidPost(request.resource.data);
      allow update: if isAdmin() && isValidPost(request.resource.data);
      allow delete: if isAdmin();
    }

    // Comments Collection: only signed-in visitors can comment (stops anonymous spam bots)
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidComment(request.resource.data);
      allow delete: if isAdmin();
    }

    // Consultation requests from the contact page: anyone can submit one, only the admin can read them
    function isValidBooking(b) {
      return b.keys().hasOnly(['topic', 'name', 'email', 'organization', 'preferredDate', 'preferredTime',
                               'timeZone', 'preferredStartUtc', 'message', 'status', 'createdAt']) &&
             b.topic is string && b.topic.size() > 0 && b.topic.size() <= 120 &&
             b.name is string && b.name.size() > 0 && b.name.size() <= 120 &&
             b.email is string && b.email.size() > 3 && b.email.size() <= 200 && b.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
             b.organization is string && b.organization.size() <= 200 &&
             b.preferredDate is string && b.preferredDate.size() <= 20 &&
             b.preferredTime is string && b.preferredTime.size() <= 10 &&
             b.timeZone is string && b.timeZone.size() <= 80 &&
             b.preferredStartUtc is string && b.preferredStartUtc.size() <= 40 &&
             b.message is string && b.message.size() <= 4000 &&
             b.status == 'new' &&
             b.createdAt == request.time;
    }

    match /bookings/{bookingId} {
      allow create: if isValidBooking(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Users Collection (for user profiles and auth synchronization)
    match /users/{userId} {
      allow read: if isSignedIn();
      // Users can manage their own profile but can never give themselves the admin or editor role
      allow create: if isAdmin() ||
                       (isSignedIn() && request.auth.uid == userId && request.resource.data.get('role', 'subscriber') in ['subscriber', 'author']);
      allow update: if isAdmin() ||
                       (isSignedIn() && request.auth.uid == userId && request.resource.data.get('role', 'subscriber') == resource.data.get('role', 'subscriber'));
      allow delete: if isAdmin();
    }

    // Settings Collection (global metadata & CMS settings)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
